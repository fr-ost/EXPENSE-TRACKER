<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Reading bank and wallet SMS, on this phone only: new messages
        (RECEIVE_SMS) and, when the person asks for the last 30 days, the
        inbox (READ_SMS). Only messages from a bank or wallet about money are
        read (SmsFilter.kt), and nothing leaves the phone. Asked for on
        Import SMS, after the app says exactly this. Notifications say what
        was added.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Tablets and Chromebooks without a SIM still install Hisab. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
        Everything Hisab records stays on this phone (and, if the person turns
        it on, in their own Google Drive). It is left out of Android's own
        backups and phone-to-phone copies: a backup file or Drive sync moves it.
    -->
    <application
        android:name=".HisabApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hisab"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- New SMS, while automatic reading is on (SmsReceiver.kt). Only the system can send these. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
