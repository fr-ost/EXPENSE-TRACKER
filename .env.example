# ---------------------------------------------------------------------------
# Hisab — environment variables
# Copy to .env for local development. On Railway, set these as service
# variables (never commit real values).
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Railway: reference the Postgres service →  ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hisab?schema=public"

# Sign in with Google: an OAuth client of type "Web application" from the
# Google Cloud console, with this authorised redirect URI:
#   https://YOUR-DOMAIN/api/auth/google/callback
#   (local development: http://localhost:3000/api/auth/google/callback)
# For backups to Google Drive, also enable the Google Drive API in that
# project and add the scope .../auth/drive.appdata to its consent screen.
# The client secret also protects the stored Drive permissions: changing it
# means everyone connects Drive again.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only when upgrading from the password version: the Google address whose
# first sign-in takes over the ledger recorded before. Unused afterwards.
OWNER_EMAIL=""

# Optional: the app's public address (https://YOUR-DOMAIN), when it isn't
# the one requests arrive at.
APP_URL=""

# Optional: Postgres connection pool size per server process (default 10).
DATABASE_POOL_SIZE=""
