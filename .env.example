# ---------------------------------------------------------------------------
# Hisab — environment variables
# Copy to .env for local development. On Railway, set these as service
# variables (never commit real values).
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Railway: reference the Postgres service →  ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hisab?schema=public"

# Argon2id hash of your password — the plaintext is never stored anywhere.
# Generate it with:  npm run hash-password
# Used only to create the single account on first start (see README).
# If your platform or shell mangles "$" characters, use the "base64:..." form
# that the same command prints.
ADMIN_PASSWORD_HASH=""

# Optional: shown in the greeting. Also editable in Settings.
ADMIN_DISPLAY_NAME=""

# Optional defaults for the account on first start (editable in Settings).
DEFAULT_CURRENCY="BDT"
DEFAULT_TIMEZONE="Asia/Dhaka"

# Recovery: set to "true" (with a new ADMIN_PASSWORD_HASH) and restart to
# replace a forgotten password. This signs out every session. Remove it after.
FORCE_PASSWORD_RESET=""

# Optional: Postgres connection pool size per server process (default 10).
DATABASE_POOL_SIZE=""
