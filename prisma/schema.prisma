// Hisab — private personal finance ledger.
//
// Money columns are NUMERIC(14,2); never floats. Account balances are NOT
// stored: they are derived from the transaction ledger through the
// "LedgerEntry" view (see the migrations). Invariants that Prisma cannot
// express (CHECK constraints, views) live in the migration SQL.
//
// Every row belongs to one user (`userId`). References between a user's rows
// are composite foreign keys on (userId, id), so the database itself refuses
// a transaction on someone else's account or category.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  BANK
  MOBILE_WALLET
  CARD
  EXCHANGE
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

enum CategoryKind {
  INCOME
  EXPENSE
}

/// Who an expense was for: your family or yourself. Each has its own
/// monthly budget (ScopeBudget).
enum ExpenseScope {
  FAMILY
  PERSONAL
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum NumberFormat {
  SOUTH_ASIAN
  INTERNATIONAL
}

enum CheckpointSource {
  MANUAL
  SMS
}

/// One person and their preferences. Everything else hangs off a user and is
/// removed only by `deleteUserData` (nothing cascades from here except
/// sessions), so no data disappears by accident.
///
/// People sign in with Google; nothing secret about that is stored here.
model User {
  id              String                 @id @default(cuid())
  /// Google's permanent id for the account (the ID token's "sub"). Null only
  /// for the owner from before Google sign-in, until they sign in with the
  /// Google account named by OWNER_EMAIL and take the row over.
  googleSub       String?                @unique @db.VarChar(255)
  /// The Google account's address at the last sign-in. Shown in Settings;
  /// never used to tell users apart (addresses can change hands).
  email           String?                @db.VarChar(320)
  displayName     String                 @default("") @db.VarChar(60)
  baseCurrency    String                 @default("BDT") @db.Char(3)
  timezone        String                 @default("Asia/Dhaka") @db.VarChar(64)
  numberFormat    NumberFormat           @default(SOUTH_ASIAN)
  /// App lock: the PIN's scrypt hash (auth/pin.ts), or null when the lock is off.
  pinHash         String?                @db.VarChar(255)
  /// Wrong PINs in a row. Every fifth makes the next try wait (pinLockedUntil).
  pinFailures     Int                    @default(0)
  pinLockedUntil  DateTime?
  /// With a PIN: minutes of inactivity before the app locks. 0: only "Lock now".
  autoLockMinutes Int                    @default(15)
  /// The currency a new income / expense starts in (null: baseCurrency).
  incomeCurrency  String?                @db.Char(3)
  expenseCurrency String?                @db.Char(3)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sessions        Session[]
  accounts        Account[]
  categories      Category[]
  transactions    Transaction[]
  checkpoints     BalanceCheckpoint[]
  budgets         ScopeBudget[]
  rates           ExchangeRate[]
  recurring       RecurringTransaction[]
  drive           DriveBackup?
}

/// The user's permission for Hisab to keep backups in their Google Drive, in
/// the app's own hidden folder (scope "drive.appdata": Hisab can neither see
/// nor touch any other file there). Like a session, it goes with the user.
model DriveBackup {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Google's refresh token for that one scope, encrypted (drive/tokens.ts).
  refreshToken   String    @db.Text
  connectedAt    DateTime  @default(now())
  /// When a backup last reached Drive.
  lastBackupAt   DateTime?
  /// SHA-256 of what that backup held, so an unchanged ledger isn't uploaded again.
  lastBackupHash String?   @db.Char(64)
  /// When a backup was last tried (automatic ones wait a while after a failure).
  lastAttemptAt  DateTime?
  /// Why the last try failed, if it did: "reconnect" when Google has withdrawn
  /// the permission, otherwise a short description.
  lastError      String?   @db.VarChar(200)
}

/// Server-side session. `id` is the SHA-256 of the cookie token, so a database
/// leak does not yield usable session cookies.
model Session {
  id         String    @id @db.Char(64)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  /// Locked until the PIN is entered. Only means something while the user has a PIN.
  lockedAt   DateTime?
  userAgent  String?   @db.VarChar(255)

  @@index([userId])
  @@index([expiresAt])
}

/// Sign-ins that came back from Google, used to slow down a client that keeps
/// failing. Stored in the database so limits survive restarts and redeploys.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String   @db.VarChar(64)
  success   Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
}

/// Where money physically lives.
model Account {
  id                String                 @id @default(cuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  name              String                 @db.VarChar(60)
  type              AccountType
  currency          String                 @default("BDT") @db.Char(3)
  openingBalance    Decimal                @default(0) @db.Decimal(14, 2)
  openingDate       DateTime               @db.Date
  isActive          Boolean                @default(true)
  icon              String?                @db.VarChar(32)
  color             String?                @db.VarChar(16)
  sortOrder         Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  transactions      Transaction[]          @relation("TransactionAccount")
  incomingTransfers Transaction[]          @relation("TransferDestination")
  checkpoints       BalanceCheckpoint[]
  recurring         RecurringTransaction[] @relation("RecurringAccount")
  recurringIncoming RecurringTransaction[] @relation("RecurringDestination")

  @@unique([userId, name])
  /// What the composite foreign keys point at.
  @@unique([userId, id])
}

model Category {
  id           String                 @id @default(cuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  name         String                 @db.VarChar(40)
  kind         CategoryKind
  /// Default classification for new expenses in this category.
  defaultScope ExpenseScope?
  icon         String                 @db.VarChar(32)
  color        String                 @db.VarChar(16)
  isArchived   Boolean                @default(false)
  sortOrder    Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  transactions Transaction[]
  recurring    RecurringTransaction[]

  @@unique([userId, kind, name])
  @@unique([userId, id])
}

/// One row per financial event.
///
/// - INCOME / EXPENSE: `accountId` is the account; `amount` > 0.
/// - TRANSFER: `accountId` is the source, `toAccountId` the destination.
///   `toAmount` is set only when the two accounts use different currencies.
///   `countAsExpense` additionally recognises the amount as spending
///   (requires a category) without moving money twice.
/// - ADJUSTMENT: reconciliation correction; `amount` is signed and non-zero.
model Transaction {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  type           TransactionType
  amount         Decimal               @db.Decimal(14, 2)
  date           DateTime              @db.Date
  /// Local time of day ("HH:MM") when known, e.g. from a bank SMS.
  time           String?               @db.Char(5)
  /// Without a `time`: the local time it was recorded ("HH:MM:SS"), if that
  /// was on its own date. Never shown; it only places the entry against
  /// balance updates made that day (otherwise an entry without a time counts
  /// at the end of its day).
  loggedTime     String?               @db.Char(8)
  accountId      String
  account        Account               @relation("TransactionAccount", fields: [userId, accountId], references: [userId, id], onDelete: Restrict)
  toAccountId    String?
  toAccount      Account?              @relation("TransferDestination", fields: [userId, toAccountId], references: [userId, id], onDelete: Restrict)
  toAmount       Decimal?              @db.Decimal(14, 2)
  categoryId     String?
  category       Category?             @relation(fields: [userId, categoryId], references: [userId, id], onDelete: Restrict)
  countAsExpense Boolean               @default(false)
  scope          ExpenseScope?
  description    String                @default("") @db.VarChar(140)
  notes          String?               @db.VarChar(2000)
  /// The rule that posted it. Deleting a rule keeps what it posted
  /// (`deleteRecurring` clears this first).
  recurringId    String?
  recurring      RecurringTransaction? @relation(fields: [userId, recurringId], references: [userId, id], onDelete: Restrict)
  occurrenceDate DateTime?             @db.Date
  /// False for entries kept for the record (reports) that must not move the
  /// account balance, e.g. old spending already included in a balance.
  affectsBalance Boolean               @default(true)
  /// Client-generated key that makes "create" idempotent (double-submit
  /// safe); "sms:…" for an imported message. Unique per user.
  idempotencyKey String?               @db.VarChar(64)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([userId, idempotencyKey])
  @@unique([recurringId, occurrenceDate])
  @@index([userId, date])
  @@index([accountId, date])
  @@index([toAccountId, date])
  @@index([categoryId, date])
  @@index([userId, type, date])
}

/// "At this moment the account held exactly this much" — from the bank or
/// wallet app, a cash count, or an SMS. Balances are still derived from the
/// ledger: the "BalanceCorrection" view adds whatever correction makes the
/// balance match at each checkpoint, so entries dated before a checkpoint
/// never change the balance after it.
model BalanceCheckpoint {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  accountId   String
  account     Account          @relation(fields: [userId, accountId], references: [userId, id], onDelete: Cascade)
  date        DateTime         @db.Date
  /// "HH:MM" (local time); null means the end of the day…
  time        String?          @db.Char(5)
  /// …unless it was recorded that same day: then the local time it was
  /// recorded ("HH:MM:SS").
  loggedTime  String?          @db.Char(8)
  balance     Decimal          @db.Decimal(14, 2)
  source      CheckpointSource @default(MANUAL)
  note        String?          @db.VarChar(500)
  /// For balances read from an SMS, so importing the message again adds
  /// nothing. Unique per user.
  smsKey      String?          @db.VarChar(64)
  /// For an SMS: when the message was sent ("HH:MM" when it says). The newest
  /// message sets the balance as of when it was read (`date` / `loggedTime`).
  messageDate DateTime?        @db.Date
  messageTime String?          @db.Char(5)
  createdAt   DateTime         @default(now())

  @@unique([userId, smsKey])
  @@index([accountId, date])
}

/// Effective-dated monthly budget for Family or Personal spending, whatever
/// the category. The budget for month M is the row with the latest
/// `effectiveFrom` <= M, so changing a budget never rewrites history. An
/// amount of 0 means "no budget from this month on".
model ScopeBudget {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  scope         ExpenseScope
  effectiveFrom DateTime     @db.Date
  amount        Decimal      @db.Decimal(14, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, scope, effectiveFrom])
}

/// What one unit of `currency` is worth in `base` (the main currency), set by
/// the user. Without one, the rate of the latest conversion between the two
/// is used (services/currency.ts).
model ExchangeRate {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  base      String   @db.Char(3)
  currency  String   @db.Char(3)
  rate      Decimal  @db.Decimal(18, 6)
  updatedAt DateTime @updatedAt

  @@id([userId, base, currency])
}

/// A rule that materialises transactions on schedule. Occurrence k falls on
/// startDate + k periods (month-end clamped), so a rule anchored on the 31st
/// posts on Feb 28/29 and returns to the 31st in March.
model RecurringTransaction {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  type            TransactionType
  amount          Decimal             @db.Decimal(14, 2)
  accountId       String
  account         Account             @relation("RecurringAccount", fields: [userId, accountId], references: [userId, id], onDelete: Restrict)
  toAccountId     String?
  toAccount       Account?            @relation("RecurringDestination", fields: [userId, toAccountId], references: [userId, id], onDelete: Restrict)
  toAmount        Decimal?            @db.Decimal(14, 2)
  categoryId      String?
  category        Category?           @relation(fields: [userId, categoryId], references: [userId, id], onDelete: Restrict)
  countAsExpense  Boolean             @default(false)
  scope           ExpenseScope?
  description     String              @default("") @db.VarChar(140)
  notes           String?             @db.VarChar(2000)
  frequency       RecurrenceFrequency
  startDate       DateTime            @db.Date
  endDate         DateTime?           @db.Date
  /// Index of the next occurrence to post (0-based from startDate).
  occurrenceIndex Int                 @default(0)
  /// Date of the next occurrence; null once the rule has run past endDate.
  nextOccurrence  DateTime?           @db.Date
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  transactions    Transaction[]

  @@unique([userId, id])
  @@index([userId, isActive, nextOccurrence])
}
